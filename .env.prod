# =============================================================================
# Amar Hisab – PRODUCTION environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---------- Core backend -------------------------------------------------
# Port the Dart/Shelf server listens on (inside the `backend` container).
PORT=8080

# Host/interface to bind – keep 0.0.0.0 inside Docker.
HOST=0.0.0.0

# SQLite database file path (persisted via the `amar_hisab_data` volume).
DB_PATH=/app/data/amar_hisab.db

# Logging verbosity: debug | info | warning | error.
LOG_LEVEL=info

# Secret used to sign JWT tokens. REQUIRED – generate with:
#   openssl rand -base64 48
JWT_SECRET=__CHANGE_ME_long_random_string__

# ---------- Cloud sync (optional) ----------------------------------------
# Set to "true" to enable the background sync engine + the gRPC sync
# service container.  Leave "false" for fully-offline / single-site installs
# (Production Deployment Guide §8).
CLOUD_SYNC_ENABLED=false

# gRPC host the backend's sync client dials (service name inside compose).
SYNC_HOST=sync
SYNC_PORT=9090

# Unique id of *this* node in the sync mesh (default: auto-generated).
SYNC_DEVICE_ID=

# Business id this server hosts (single-tenant local server, default 1).
SYNC_BUSINESS_ID=1

# ---------- PostgreSQL (sync store) --------------------------------------
POSTGRES_USER=amarhisab
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=amarhisab_sync
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Redis (sync cache / queue) ------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME__

# ---------- TLS / domain (nginx + certbot) --------------------------------
# Domain that resolves to this server – required for the Let's Encrypt
# certificate.  Example: hisab.example.com
TLS_DOMAIN=hisab.example.com
# Email used for Let's Encrypt expiry notices.
TLS_EMAIL=admin@example.com
